{
  "name": "pdf-xploder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Free PDF editor that runs in the browser: annotate, organise, fill, sign, OCR, redact and protect PDFs without uploading them. Inspired by PDF-XChange Editor.",
  "keywords": [
    "pdf",
    "pdf-editor",
    "pdf-viewer",
    "online-pdf-editor",
    "pdf-annotation",
    "pdf-forms",
    "pdf-signature",
    "digital-signature",
    "ocr",
    "redaction",
    "pdf-merge",
    "pdf-split",
    "offline",
    "pwa",
    "browser",
    "react",
    "pdfjs",
    "pdf-lib",
    "pdf-xchange",
    "acrobat-alternative"
  ],
  "homepage": "https://stackoverbuffer.github.io/PDF-Xploder/",
  "repository": {
    "type": "git",
    "url": "https://github.com/StackOverBuffer/PDF-Xploder.git"
  },
  "bugs": {
    "url": "https://github.com/StackOverBuffer/PDF-Xploder/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@pdf-lib/fontkit": "1.1.1",
    "harfbuzzjs": "1.6.1",
    "lucide-react": "0.468.0",
    "node-forge": "1.4.0",
    "pdfjs-dist": "4.10.38",
    "qrcode-generator": "^1.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tesseract.js": "7.0.0",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "22.10.7",
    "@types/node-forge": "1.3.11",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "6.0.11",
    "vitest": "3.0.5"
  }
}
