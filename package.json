    "@pdf-lib/fontkit": "1.1.1",
    "harfbuzzjs": "1.6.1",
    "lucide-react": "0.468.0",
    "node-forge": "1.4.0",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tesseract.js": "7.0.0",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "22.10.7",
    "@types/node-forge": "1.3.11",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
