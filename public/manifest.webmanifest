{
  "name": "PDF-Xploder",
  "short_name": "PDF-Xploder",
  "description": "Free PDF editor in your browser: annotate, organise, fill, sign, OCR and protect PDFs. Files never leave your device.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#e9ecf1",
  "theme_color": "#1a5fb4",
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      },
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities",
    "business"
  ],
  "screenshots": [
    {
      "src": "screenshot-wide.jpg",
      "sizes": "1440x900",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "A PDF with a highlight, a stamp and drawn comments"
    }
  ]
}
