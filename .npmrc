# Supply-chain hardening (see SECURITY.md).
# One registry only: no mirrors, no extra indexes, no private scopes.
registry=https://registry.npmjs.org/
# Never run dependencies' install/lifecycle scripts (postinstall etc.). Nothing here needs them:
# esbuild's binary comes from its @esbuild/<platform> optional dependency, and tesseract.js's
# postinstall only prints a donation message. `npm run <script>` still works.
ignore-scripts=true
# New dependencies are saved with an exact version, never a ^range.
save-exact=true
audit=true
